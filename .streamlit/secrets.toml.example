# Copy this file to .streamlit/secrets.toml (or paste it in Streamlit Cloud → Settings → Secrets)

[auth]
password = "change-me"            # staff of both branches
admin_password = "change-me-too"  # settings, delete, restore, import

# Optional but recommended on Streamlit Cloud: every save is stored in a GitHub repo
# (same approach as the home-visit app). Use a fine-grained token with
# "Contents: Read and write" on that repo only.
[github]
token = "github_pat_xxx"
repo = "your-account/orange-inventory-data"
branch = "main"
path = "data/inventory_db.json"
